@WebApiWithDb_HostAddress = http://localhost:5155

### 1. Create Player 1 (Alice)
POST {{WebApiWithDb_HostAddress}}/api/players
Content-Type: application/json

{
  "name": "Alice"
}

### 2. Create Player 2 (Bob)
POST {{WebApiWithDb_HostAddress}}/api/players
Content-Type: application/json

{
  "name": "Bob"
}

### 3. Get All Players
GET {{WebApiWithDb_HostAddress}}/api/players
Accept: application/json

### 4. Get Player By ID
GET {{WebApiWithDb_HostAddress}}/api/players/1
Accept: application/json

### 5. Update Player
PUT {{WebApiWithDb_HostAddress}}/api/players/1
Content-Type: application/json

{
  "name": "Alice Johnson"
}

### 6. Create Game
POST {{WebApiWithDb_HostAddress}}/api/games
Content-Type: application/json

{
  "gameId": "MATCH-2026-001"
}

### 7. Add Player 1 (Alice) to Game 1
POST {{WebApiWithDb_HostAddress}}/api/games/1/players
Content-Type: application/json

{
  "playerId": 1
}

### 8. Add Player 2 (Bob) to Game 1
POST {{WebApiWithDb_HostAddress}}/api/games/1/players
Content-Type: application/json

{
  "playerId": 2
}

### 9. Update Alice's Score in Game 1
PUT {{WebApiWithDb_HostAddress}}/api/games/1/score
Content-Type: application/json

{
  "playerId": 1,
  "score": 95
}

### 10. Update Bob's Score in Game 1
PUT {{WebApiWithDb_HostAddress}}/api/games/1/score
Content-Type: application/json

{
  "playerId": 2,
  "score": 80
}

### 11. Update Entire ScoreBoard for Game 1
PUT {{WebApiWithDb_HostAddress}}/api/games/1/scoreboard
Content-Type: application/json

{
  "scoreBoard": {
    "1": 100,
    "2": 85
  }
}

### 12. Get All Games (with ScoreBoard)
GET {{WebApiWithDb_HostAddress}}/api/games
Accept: application/json

### 13. Get Game By ID
GET {{WebApiWithDb_HostAddress}}/api/games/1
Accept: application/json

### 14. Get Leaderboard (Computed from Highest Score in any Game)
GET {{WebApiWithDb_HostAddress}}/api/players/leaderboard?topCount=10
Accept: application/json

### 15. Finish Game
POST {{WebApiWithDb_HostAddress}}/api/games/1/finish
Content-Type: application/json

{
  "winner": "Alice Johnson"
}

### 16. Delete Game
DELETE {{WebApiWithDb_HostAddress}}/api/games/1

### 17. Delete Player
DELETE {{WebApiWithDb_HostAddress}}/api/players/1
